{
  "name": "gather-app-bridge",
  "version": "0.2.0",
  "description": "Connects to Gather V2 with your own session and streams presence events \u2014 who is standing next to you, who is following you, who is talking \u2014 to the Gather Companion phone app over your LAN.",
  "license": "MIT",
  "author": "Jonas Grunau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonasGrunau/gather_companion.git"
  },
  "homepage": "https://github.com/JonasGrunau/gather_companion#readme",
  "bugs": "https://github.com/JonasGrunau/gather_companion/issues",
  "type": "module",
  "bin": {
    "gather-app-bridge": "bridge/bin/gather-bridge.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bridge/bin",
    "bridge/lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"bridge/test/*.test.js\"",
    "start": "node bridge/bin/gather-bridge.js run",
    "replay": "node bridge/bin/gather-bridge.js replay"
  },
  "keywords": [
    "gather",
    "gather-town",
    "presence",
    "proximity",
    "follow",
    "bridge",
    "websocket"
  ],
  "os": [
    "darwin"
  ]
}
