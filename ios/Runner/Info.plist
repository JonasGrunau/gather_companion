<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Home-screen label only. iOS clips it to about ten characters, and
	     "Gather Companion" came out as "GatherCom…"; the full name lives in the
	     app itself. -->
	<key>CFBundleDisplayName</key>
	<string>Gather</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gather_companion</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Answers App Store Connect's export-compliance question up front. The app
	     ships no encryption of its own: it talks plain http/ws to a bridge on
	     your own LAN. Omitting this strands every upload in "Missing
	     Compliance", where it cannot be installed from TestFlight until
	     answered by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Two uses now, and the string has to cover both. It said only "scanning
	     the pairing square" while the app also published video, which is a
	     rejection at App Review and a lie to the person reading the prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>Scanning the pairing square shown by the bridge on your Mac, and showing your face to the people you are talking to in Gather.</string>
	<!-- Absent, this is a hard crash rather than a denial: iOS terminates the
	     process the first time an audio session is activated for recording with
	     no purpose string. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talking to the people standing next to you in your Gather space.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gather Companion connects to the bridge running on your Mac to show who is next to you and who is following you.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The bridge is a plain-http/ws server on your own LAN, so ATS has to
		     allow local networking. Nothing leaves your network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Keeps the socket alive briefly after the app leaves the foreground so
		     an alert can still be delivered. iOS suspends it soon after; the log is
		     backfilled by sequence number on the next resume. -->
		<string>fetch</string>
		<!-- Once suspended, the socket is gone and only a push can reach us. This
		     lets a delivered notification hand the app a moment to run before the
		     user taps it; the alert itself is shown either way. -->
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
