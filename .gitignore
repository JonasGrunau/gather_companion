# Local tooling state (oh-my-claudecode session/mission scratch). Not project code,
# and it appears in several subdirectories, so match it at any depth.
.omc/

# Node — the bridge is deliberately dependency-free, but devDependencies or a
# stray install must never land here.
node_modules/
npm-debug.log*

# Dart / Flutter. The app lives at the repository root, so these are the
# standard Flutter ignores rather than anything specific to this project.
.dart_tool/
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Xcode / Swift Package Manager scratch. The iOS side uses SPM rather than
# CocoaPods, so .swiftpm is the one that actually accumulates here.
.swiftpm/
**/.symlinks/
**/DerivedData/
xcuserdata

# Symbolication and obfuscation output, written next to a --split-debug-info or
# --obfuscate build.
app.*.symbols
app.*.map.json

# Editors
*.iml
*.ipr
*.iws
.idea/
*.swp

# Generated by tool/make_icons.mjs --preview; the committed icons live in
# ios/Runner/Assets.xcassets/AppIcon.appiconset.
/tool/icon-preview.png

# macOS
.DS_Store

# Anything a run leaves behind
*.log

# Firebase service accounts. The real one lives at ~/.gather-app-bridge-fcm.json
# and never belongs in the repo — it can send push as this project. This is a
# guard against a downloaded key being dropped in here by accident; the download
# is named `<project>-firebase-adminsdk-<hash>-<id>.json`.
*-firebase-adminsdk-*.json
service-account*.json

# Unredacted SFU captures from `tool/probe-sfu.mjs --raw`. These carry a live
# Firebase ID token, TURN credentials, DTLS fingerprints and ICE candidates
# naming your LAN and public IPs. The probe writes a redacted transcript by
# default and only produces this when explicitly asked; committing one would
# publish a working credential.
*.raw.jsonl
sfu-capture.raw*
