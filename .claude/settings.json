{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pr-add-copilot-reviewer.sh",
            "timeout": 30,
            "statusMessage": "Requesting Copilot review on new PR..."
          }
        ]
      }
    ]
  }
}
